<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>JMW.Tests</RootNamespace>
    <AssemblyName>JMW.Tests</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepoRoot).editorconfig"
      Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NUnit"
      Version="5.0.0" />
    <PackageReference Include="NUnit.Analyzers"
      Version="4.15.0"
      PrivateAssets="all" />
    <PackageReference Include="NUnit3TestAdapter"
      Version="6.3.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk"
      Version="18.11.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)JMW.Networking/JMW.Networking.csproj" />
    <ProjectReference Include="$(RepoRoot)JMW.Parsing/JMW.Parsing.csproj" />
    <ProjectReference Include="$(RepoRoot)JMW.Templates/JMW.Templates.csproj" />
    <ProjectReference Include="$(RepoRoot)JMW/JMW.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Templates\testpathinclude.tmpl">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
