<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <Optimize>true</Optimize>
    <ServerGarbageCollection>false</ServerGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet"
      Version="0.15.8" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(RepoRoot)JMW/JMW.csproj" />
    <ProjectReference Include="$(RepoRoot)JMW.Networking/JMW.Networking.csproj" />
    <ProjectReference Include="$(RepoRoot)JMW.Parsing/JMW.Parsing.csproj" />
    <ProjectReference Include="$(RepoRoot)JMW.Templates/JMW.Templates.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(RepoRoot)JMW.Tests/Networking/junos.txt"
      Link="junos.txt"
      CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
